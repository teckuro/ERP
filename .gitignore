/dist
/tmp
/out-tsc
/bazel-out

# Node
/node_modules
npm-debug.log
yarn-error.log
.angular-dev-server*.log

# IDEs and editors
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/*

# Cursor — reglas/skills locales (no publicar)
.cursor/

# Documentación interna de agentes / diseño / bitácora (solo local)
/docs/

# Miscellaneous
# Copia local de respaldo del proyecto (no versionar)
/angular-erp.zip
/.angular/cache
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/
/public/app-config.json

# System files
.DS_Store
Thumbs.db

src/app/supabase
/tests/__snapshots__/
/tests/**/*.png
/tests/**/*.bak
/playwright-report
/test-results
/bd/*
!/bd/README.md
!/bd/base/
/bd/base/*
!/bd/base/README.md
