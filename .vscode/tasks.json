{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: start",
      "type": "npm",
      "script": "start",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Changes detected|Building",
          "endsPattern": "bundle generation (complete|failed)|Application bundle generation complete"
        }
      },
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "npm: test",
      "type": "npm",
      "script": "test",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": "$tsc",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Changes detected|Building",
          "endsPattern": "bundle generation (complete|failed)|Application bundle generation complete"
        }
      },
      "group": "test"
    },
    {
      "label": "ng test (sin watch)",
      "type": "shell",
      "command": "npx ng test --watch=false",
      "group": "test",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "lint: texto",
      "type": "npm",
      "script": "lint:texto",
      "problemMatcher": []
    },
    {
      "label": "lint: nomina rules",
      "type": "npm",
      "script": "lint:nomina-rules",
      "problemMatcher": []
    },
    {
      "label": "test gate empleados (unit)",
      "type": "npm",
      "script": "test:gate:empleados:unit",
      "group": "test",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "test gate parametros (unit)",
      "type": "npm",
      "script": "test:gate:parametros:unit",
      "group": "test",
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "e2e nomina flujo completo",
      "type": "npm",
      "script": "test:e2e:nomina-flujo-completo",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
