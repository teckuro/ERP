{
  "workbench.secondarySideBar.defaultVisibility": "visibleInWorkspace",
  "window.restoreWindows": "all",

  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.preferences.importModuleSpecifier": "relative",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "modificationsIfAvailable",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.tabSize": 2,
  "editor.rulers": [100],
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[markdown]": {
    "editor.wordWrap": "on"
  },

  "angular.enable-strict-mode-prompt": false,
  "html.format.wrapAttributes": "aligned-multiple",

  "files.exclude": {
    "**/.angular": true
  },
  "search.exclude": {
    "**/.angular": true,
    "**/dist": true,
    "**/node_modules": true,
    "**/playwright-report": true,
    "**/test-results": true,
    "**/coverage": true
  },
  "files.watcherExclude": {
    "**/.angular/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true
  },

  "files.associations": {
    "*.css": "tailwindcss"
  },

  "deno.enablePaths": ["supabase/functions"],

  "errorLens.enabledDiagnosticLevels": ["error", "warning"],

  "cSpell.language": "es,en",
  "cSpell.diagnosticLevel": "Information",
  "cSpell.ignorePaths": [
    "node_modules", "dist", ".angular", "package-lock.json",
    "src/app/core/models/database.types.ts", "test-results", "playwright-report"
  ],
  "cSpell.words": [
    "AFC", "AFP", "APVI", "CCAF", "finiquito", "Fonasa", "honorarios", "Isapre",
    "LRE", "liquidaciones", "nómina", "nóminas", "Previred", "remuneraciones", "RUT",
    "SIS", "UF", "UTA", "UTM", "dotación", "subsidio",
    "lucide", "pdfplumber", "Supabase", "tailwindcss", "vitest", "zoneless"
  ]
}
