# Copiar a `.env` y completar según SUPABASE_SETUP.md / entorno local.
#
# Playwright — activar E2E con persistencia Supabase (empleados / borrador avanzada).
# Sin esto, `tests/empleados-borrador-persistencia.spec.ts` queda en skip.
# Ejecutar: `npm run test:e2e:empleados-borrador`
E2E_EMPLEADOS_BORRADOR=1

# Playwright - nomina mensual real con usuario Supabase Auth authenticated.
# Completar solo en `.env` local o variables de la sesion; no versionar valores reales.
E2E_NOMINA_REAL=
E2E_SUPABASE_AUTH_EMAIL=
E2E_SUPABASE_AUTH_PASSWORD=
E2E_NOMINA_PERIODO=

# Opcional: overrides para apuntar E2E a otro proyecto Supabase controlado.
# Usar host `.supabase.co` (no `.supabase.com`). Si no se definen, el E2E usa `public/app-config.json`.
E2E_SUPABASE_URL=
E2E_SUPABASE_ANON_KEY=

# Conexion SQL para validaciones post-E2E. Nunca commitear la cadena real.
SUPABASE_DB_URL=
