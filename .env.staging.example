# Ambiente DEV (base de pruebas en Supabase). Copie este archivo a .env.staging y complete los valores.
# .env.staging está en .gitignore: nunca se sube a git.
#
# Use SOLO credenciales del proyecto de pruebas. Las de producción no se comparten:
# las tiene únicamente el dueño del proyecto.
#
# La contraseña dentro de la URL debe ir sin corchetes. Si tiene caracteres especiales,
# codifíquelos (% → %25, @ → %40, # → %23, / → %2F, : → %3A) o use solo letras y números.

# Dashboard → Connect → Connection string → Method: "Session pooler" (puerto 5432)
STAGING_DB_URL=postgresql://postgres.<id-proyecto>:<clave>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Project Settings → API → Project URL
STAGING_SUPABASE_URL=https://<id-proyecto>.supabase.co

# Project Settings → API → Publishable key (sb_publishable_...)
STAGING_SUPABASE_ANON_KEY=
