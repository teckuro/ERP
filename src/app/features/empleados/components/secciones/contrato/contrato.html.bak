<section class="labor-shell" [formGroup]="formGroup">
  <div class="labor-head is-hidden">
    <p class="labor-kicker">Referencia laboral</p>
    <h3 class="labor-title">Datos laborales</h3>
  </div>

  @if (isBlockVisible('relacion')) {
  <app-card className="labor-block">
    <div class="labor-block-head">
      <h4>Relación laboral</h4>
      <p>Selecciona la modalidad de relación laboral del colaborador.</p>
    </div>
    <div class="relation-grid">
      @for (option of relationOptions; track option.value) {
        <label class="relation-option">
          <input
            type="radio"
            name="relacionLaboral"
            [checked]="formGroup.controls.relacionLaboral.value === option.value"
            (change)="onRelacionLaboralChange(option.value)"
          />
          <span>{{ option.label }}</span>
        </label>
      }
    </div>
    @if (isHonorariosMode) {
      <div class="honorarios-note" role="status">
        <strong>Boleta de honorarios</strong>
        <span>Este registro se tratará como prestador de servicios. No corresponde jornada laboral, gratificación, previsión dependiente ni asignaciones laborales.</span>
      </div>
    }
  </app-card>
  }

  @if (isBlockVisible('contratoBase')) {
  <app-card className="labor-block">
    <div class="labor-block-head">
      <h4>{{ isHonorariosMode ? 'Datos del servicio' : 'Contrato' }}</h4>
      @if (isHonorariosMode) {
        <p>Registra los datos administrativos del servicio a honorarios. No se genera contrato laboral dependiente.</p>
      }
    </div>
    <div class="labor-grid labor-grid--contract">
      <div class="form-field">
        <div class="field-label-row">
          <label for="empleado-tipo-trabajador"
            >Tipo trabajador</label
          >
          @if (isRequired('idTipoTrabajador')) {
            <span class="field-required" aria-hidden="true">*</span>
          }
        </div>
        <app-search-select
          id="empleado-tipo-trabajador"
          formControlName="idTipoTrabajador"
          placeholder="Selecciona un tipo"
          searchPlaceholder="Buscar tipo trabajador"
          [options]="tiposTrabajadorSelectOptions"
          [invalid]="hasError('idTipoTrabajador')"
        ></app-search-select>
        @if (hasError('idTipoTrabajador', 'required')) {
          <p class="field-message">El tipo de trabajador es obligatorio.</p>
        } @else {
          <p class="field-message"></p>
        }
      </div>

      @if (!isHonorariosMode) {
        <div class="form-field">
          <div class="field-label-row">
            <label for="empleado-tipo-contrato"
              >Tipo de contrato</label
            >
            @if (isRequired('tipoContrato')) {
              <span class="field-required" aria-hidden="true">*</span>
            }
          </div>
          <app-search-select
            id="empleado-tipo-contrato"
            formControlName="tipoContrato"
            placeholder="Tipo de contrato"
            searchPlaceholder="Buscar tipo de contrato"
            [options]="tipoContratoSelectOptions"
            [invalid]="hasError('tipoContrato')"
          ></app-search-select>
          <p class="field-message"></p>
        </div>

        <div class="form-field form-field--checkbox labor-toggle-field">
          <div class="field-label-row">
            <label for="empleado-indefinido"
              >Indefinido</label
            >
          </div>
          <label class="employee-checkbox-row">
            <input
              id="empleado-indefinido"
              type="checkbox"
              [checked]="isIndefinido"
              (change)="onIndefinidoToggle($any($event.target).checked)"
            />
            <span>Contrato indefinido</span>
          </label>
          <p class="field-message field-message--hint">
            Si el contrato es indefinido, no se exige fecha de término.
          </p>
        </div>
      }

      <div class="labor-field-section labor-field-section--span">
        <p class="labor-field-section-title">{{ isHonorariosMode ? 'Fechas del servicio' : 'Fechas del contrato' }}</p>
      </div>

      <div class="form-field">
        <div class="field-label-row">
          <label for="empleado-fecha-ingreso"
            >{{ isHonorariosMode ? 'Fecha inicio del servicio' : 'Fecha ingreso' }}</label
          >
          @if (isRequired('fechaIngreso')) {
            <span class="field-required" aria-hidden="true">*</span>
          }
        </div>
        <app-calendar-input
          id="empleado-fecha-ingreso"
          formControlName="fechaIngreso"
          placeholder="dd/mm/aaaa"
          [invalid]="hasError('fechaIngreso')"
        ></app-calendar-input>
        @if (hasError('fechaIngreso', 'required')) {
          <p class="field-message">{{ isHonorariosMode ? 'La fecha de inicio del servicio es obligatoria.' : 'La fecha de ingreso es obligatoria.' }}</p>
        } @else {
          <p class="field-message"></p>
        }
      </div>

      @if (!isHonorariosMode) {
        <div class="form-field">
          <div class="field-label-row">
            <label for="empleado-fecha-contrato"
              >Fecha contrato</label
            >
            @if (isRequired('fechaContrato')) {
              <span class="field-required" aria-hidden="true">*</span>
            }
          </div>
          <app-calendar-input
            id="empleado-fecha-contrato"
            formControlName="fechaContrato"
            placeholder="dd/mm/aaaa"
            [invalid]="hasError('fechaContrato')"
          ></app-calendar-input>
          @if (hasError('fechaContrato', 'required')) {
            <p class="field-message">La fecha de contrato es obligatoria.</p>
          } @else {
            <p class="field-message"></p>
          }
        </div>

        <div class="form-field">
          <div class="field-label-row">
            <label for="empleado-fecha-termino"
              >Fecha término</label
            >
            @if (isRequired('fechaTermino')) {
              <span class="field-required" aria-hidden="true">*</span>
            }
          </div>
          <app-calendar-input
            id="empleado-fecha-termino"
            formControlName="fechaTermino"
            placeholder="dd/mm/aaaa"
            [invalid]="hasError('fechaTermino')"
          ></app-calendar-input>
          @if (hasError('fechaTermino', 'required')) {
            <p class="field-message">
              La fecha de término es obligatoria para contratos no indefinidos.
            </p>
          } @else {
            <p class="field-message"></p>
          }
        </div>
      }

    </div>
  </app-card>

  <app-card className="labor-block">
    <div class="labor-block-head">
      <h4>Organización</h4>
    </div>
    <div class="labor-grid labor-grid--organization">

      <div class="form-field">
        <div class="field-label-row">
          <label for="empleado-departamento"
            >Departamento</label
          >
        </div>
        <app-search-select
          id="empleado-departamento"
          formControlName="idDepartamentoEmpresa"
          placeholder="Selecciona un departamento"
          searchPlaceholder="Buscar departamento"
          [options]="departamentosSelectOptions"
          [invalid]="hasError('idDepartamentoEmpresa')"
        ></app-search-select>
        @if (!departamentosFiltrados.length) {
          <p class="field-message field-message--warning">
            No hay departamentos para la sucursal seleccionada.
          </p>
        } @else {
          <p class="field-message"></p>
        }
      </div>

      <div class="form-field">
        <div class="field-label-row">
          <label for="empleado-sucursal">{{ isHonorariosMode ? 'Sucursal / imputación interna' : 'Sucursal' }}</label>
          @if (!isHonorariosMode) {
            <span class="field-required" aria-hidden="true">*</span>
          }
        </div>
        <app-search-select
          id="empleado-sucursal"
          formControlName="idSucursal"
          placeholder="Selecciona una sucursal"
          searchPlaceholder="Buscar sucursal"
          [options]="sucursalesSelectOptions"
          [invalid]="hasError('idSucursal')"
        ></app-search-select>
        <p class="field-message"></p>
      </div>
    </div>
  </app-card>
  }

  @if (isBlockVisible('remuneracion')) {
  @if (isHonorariosMode) {
    <app-card className="labor-block labor-block--honorarios">
      <div class="labor-block-head">
        <h4>Monto de honorarios</h4>
        <p>Informa el monto bruto pactado. Este dato no genera jornada laboral ni remuneración dependiente.</p>
      </div>
      <div class="labor-grid labor-grid--base-pay">
        <div class="form-field">
          <div class="field-label-row">
            <label for="empleado-sueldo-base">{{ baseAmountLabel() }}</label>
            @if (isRequired('sueldoBase')) {
              <span class="field-required" aria-hidden="true">*</span>
            }
          </div>
          <input
            id="empleado-sueldo-base"
            type="number"
            formControlName="sueldoBase"
            [class]="controlClass('sueldoBase')"
          />
          @if (hasError('sueldoBase')) {
            <p class="field-message">El monto bruto debe ser mayor a cero.</p>
          } @else {
            <p class="field-message field-message--hint">{{ baseAmountHelpText() }}</p>
          }
        </div>

        <div class="form-field">
          <div class="field-label-row">
            <label for="empleado-id-moneda">Moneda</label>
          </div>
          <app-search-select
            id="empleado-id-moneda"
            formControlName="idMoneda"
            placeholder="Selecciona una moneda"
            searchPlaceholder="Buscar moneda"
            [options]="monedasSelectOptions"
            [invalid]="hasError('idMoneda')"
          ></app-search-select>
          <p class="field-message"></p>
        </div>
      </div>
    </app-card>
  } @else {
  <app-card className="labor-block labor-block--schedule">
    <div class="labor-block-head">
      <h4>Jornada laboral</h4>
      <p>Indica la jornada pactada para efectos de control y cálculo.</p>
    </div>
    <div class="labor-grid labor-grid--schedule">
      <div class="form-field">
        <div class="field-label-row">
          <label for="empleado-tipo-jornada"
            >Tipo jornada</label
          >
          @if (isRequired('idTipoJornada')) {
            <span class="field-required" aria-hidden="true">*</span>
          }
        </div>
        <app-search-select
          id="empleado-tipo-jornada"
          formControlName="idTipoJornada"
          placeholder="Selecciona una jornada"
          searchPlaceholder="Buscar jornada"
          [options]="tiposJornadaSelectOptions"
          [invalid]="hasError('idTipoJornada')"
        ></app-search-select>
        @if (hasError('idTipoJornada', 'required')) {
          <p class="field-message">El tipo de jornada es obligatorio.</p>
        } @else {
          <p class="field-message"></p>
        }
      </div>

      <div class="form-field">
        <div class="field-label-row">
          <label for="empleado-horas-semanales"
            >Hrs. semanales</label
          >
          @if (isRequired('horasSemanales')) {
            <span class="field-required" aria-hidden="true">*</span>
          }
        </div>
        <input
          id="empleado-horas-semanales"
          type="number"
          formControlName="horasSemanales"
          [class]="controlClass('horasSemanales')"
        />
        @if (hasError('horasSemanales')) {
          <p class="field-message">Ingresa una cantidad válida entre 1 y 168.</p>
        } @else {
          <p class="field-message"></p>
        }
      </div>

      <div class="form-field">
        <div class="field-label-row">
          <label for="empleado-dias-semanales"
            >Días semanales</label
          >
          @if (isRequired('diasSemanales')) {
            <span class="field-required" aria-hidden="true">*</span>
          }
        </div>
        <input
          id="empleado-dias-semanales"
          type="number"
          formControlName="diasSemanales"
          [class]="controlClass('diasSemanales')"
        />
        @if (hasError('diasSemanales')) {
          <p class="field-message">Ingresa una cantidad válida entre 1 y 7.</p>
        } @else {
          <p class="field-message"></p>
        }
      </div>
    </div>
  </app-card>

  <app-card className="labor-block labor-block--distribution">
    <div class="labor-block-head">
      <h4>Distribución y colación</h4>
      <p>Registra la distribución acordada y el tiempo de colación informado.</p>
    </div>
    <div class="labor-grid labor-grid--distribution">
      <div class="form-field form-field--wide">
        <div class="field-label-row">
          <label for="empleado-distribucion-jornada"
            >Distribución de la jornada</label
          >
        </div>
        <input
          id="empleado-distribucion-jornada"
          type="text"
          formControlName="distribucionJornada"
          placeholder="Ej: Lunes a viernes de 8:30 a 18:30"
          [class]="controlClass('distribucionJornada')"
        />
        <p class="field-message"></p>
      </div>

      <div class="form-field">
        <div class="field-label-row">
          <label for="empleado-tiempo-colacion">Tiempo de colación (min.)</label>
        </div>
        <input
          id="empleado-tiempo-colacion"
          type="number"
          formControlName="tiempoColacionMinutos"
          [class]="controlClass('tiempoColacionMinutos')"
        />
        @if (hasError('tiempoColacionMinutos')) {
          <p class="field-message">El tiempo de colación debe estar entre 0 y 600 minutos.</p>
        } @else {
          <p class="field-message"></p>
        }
      </div>
    </div>
  </app-card>

  <app-card className="labor-block labor-block--base-pay">
    <div class="labor-block-head">
      <h4>Remuneración base</h4>
      <p>Define la base remuneracional pactada para el contrato.</p>
    </div>
    <div class="labor-grid labor-grid--base-pay">
      <div class="form-field">
        <div class="field-label-row">
          <label for="empleado-sueldo-base"
            >{{ baseAmountLabel() }}</label
          >
          @if (isRequired('sueldoBase')) {
            <span class="field-required" aria-hidden="true">*</span>
          }
        </div>
        <input
          id="empleado-sueldo-base"
          type="number"
          formControlName="sueldoBase"
          [class]="controlClass('sueldoBase')"
        />
        @if (hasError('sueldoBase')) {
          <p class="field-message">{{ baseAmountHelpText() }}</p>
        } @else {
          <p class="field-message"></p>
        }
      </div>

      <div class="form-field">
        <div class="field-label-row">
          <label for="empleado-id-moneda">Moneda</label>
        </div>
        <app-search-select
          id="empleado-id-moneda"
          formControlName="idMoneda"
          placeholder="Selecciona una moneda"
          searchPlaceholder="Buscar moneda"
          [options]="monedasSelectOptions"
          [invalid]="hasError('idMoneda')"
        ></app-search-select>
        <p class="field-message"></p>
      </div>

      <div class="form-field">
        <div class="field-label-row">
          <label for="empleado-tipo-gratificacion"
            >Gratificación</label
          >
          @if (isRequired('tipoGratificacion')) {
            <span class="field-required" aria-hidden="true">*</span>
          }
        </div>
        <app-search-select
          id="empleado-tipo-gratificacion"
          formControlName="tipoGratificacion"
          placeholder="Gratificación"
          searchPlaceholder="Buscar gratificación"
          [options]="gratificacionSelectOptions"
          [invalid]="hasError('tipoGratificacion')"
        ></app-search-select>
        <p class="field-message"></p>
      </div>
    </div>
  </app-card>

  <app-card className="labor-block labor-block--pay-conditions">
    <div class="labor-block-head">
      <h4>Condiciones de remuneración</h4>
    </div>
    <div class="labor-grid labor-grid--pay-conditions">
      <div class="form-field form-field--checkbox labor-toggle-field">
        <div class="field-label-row">
          <label for="empleado-seguro-cesantia"
            >Seguro de cesantía</label
          >
        </div>
        <label class="employee-checkbox-row">
          <input id="empleado-seguro-cesantia" type="checkbox" formControlName="seguroCesantia" />
          <span>Activo</span>
        </label>
        <p class="field-message field-message--hint">
          Aplica seguro de cesantía cuando corresponda según el tipo de contrato.
        </p>
      </div>

      <div class="form-field form-field--checkbox">
        <div class="field-label-row">
          <label for="empleado-sueldo-variable"
            >Sueldo variable</label
          >
        </div>
        <label class="employee-checkbox-row">
          <input id="empleado-sueldo-variable" type="checkbox" formControlName="sueldoVariable" />
          <span>Aplica componente variable</span>
        </label>
        <p class="field-message field-message--hint">
          Marca si el colaborador puede recibir remuneraciones variables.
        </p>
      </div>
    </div>
  </app-card>
  }
  }

  @if (isBlockVisible('cargas')) {
  <app-card className="labor-block labor-block--loads">
    <div class="labor-block-head">
      <h4>Asignación familiar</h4>
      <p>Selecciona el tramo para visualizar el valor asociado según parámetros del período.</p>
    </div>
    <div class="labor-grid labor-grid--loads">
      <div class="form-field form-field--compact">
        <div class="field-label-row">
          <label for="empleado-cargas"
            >Cargas</label
          >
        </div>
        <input
          id="empleado-cargas"
          type="number"
          formControlName="cargas"
          [class]="controlClass('cargas')"
        />
        @if (hasError('cargas')) {
          <p class="field-message">El número de cargas no puede ser negativo.</p>
        } @else {
          <p class="field-message"></p>
        }
      </div>

      <div class="form-field">
        <div class="field-label-row">
          <label>Tramo asignado</label>
        </div>
        <app-search-select
          id="empleado-tramo-carga"
          formControlName="idTramoCarga"
          placeholder="Selecciona un tramo"
          searchPlaceholder="Buscar tramo"
          [options]="tramosCargaOptions"
          [invalid]="hasError('idTramoCarga')"
        ></app-search-select>
        @if (periodoTramoVigente; as periodo) {
          <p class="field-message">
            <span class="period-chip">Tabla vigente: {{ periodo }}</span>
          </p>
        } @else {
          <p class="field-message">
            <span class="period-chip period-chip--warning">No hay tabla vigente de cargas familiares</span>
          </p>
        }
      </div>

      <div class="form-field">
        <div class="field-label-row">
          <label>Valor por carga</label>
        </div>
        <div class="readonly-field readonly-field--calculated">{{ valorPorCarga }}</div>
        <p class="field-message"></p>
      </div>
    </div>
  </app-card>
  }

  @if (isBlockVisible('zonaExtrema')) {
  <app-card className="labor-block labor-block--zone">
    <div class="labor-block-head">
      <h4>Zona extrema</h4>
      <p>Activa esta opción solo si el colaborador aplica a una asignación por territorio especial.</p>
    </div>
    <div class="labor-grid labor-grid--zone">
      <div class="form-field form-field--checkbox labor-toggle-field">
        <div class="field-label-row">
          <label for="empleado-zona-extrema"
            >Habilitar zona extrema</label
          >
        </div>
        <label class="employee-checkbox-row">
          <input id="empleado-zona-extrema" type="checkbox" formControlName="zonaExtremaActiva" />
          <span>Activar asignación</span>
        </label>
        <p class="field-message"></p>
      </div>

      @if (formGroup.controls.zonaExtremaActiva.value) {
        <div class="form-field form-field--wide labor-detail-field labor-detail-field--primary">
          <div class="field-label-row">
            <label for="empleado-zona-territorio"
              >Territorio</label
            >
            @if (isRequired('zonaExtremaTerritorio')) {
              <span class="field-required" aria-hidden="true">*</span>
            }
          </div>
          <input
            id="empleado-zona-territorio"
            type="text"
            formControlName="zonaExtremaTerritorio"
            placeholder="Ej.: Magallanes"
            [class]="controlClass('zonaExtremaTerritorio')"
          />
          @if (hasError('zonaExtremaTerritorio')) {
            <p class="field-message">Ingresa territorio.</p>
          } @else {
            <p class="field-message"></p>
          }
        </div>

        <div class="form-field form-field--compact labor-detail-field labor-detail-field--compact">
          <div class="field-label-row">
            <label for="empleado-zona-porcentaje"
              >Asignación (%)</label
            >
            @if (isRequired('zonaExtremaPorcentaje')) {
              <span class="field-required" aria-hidden="true">*</span>
            }
          </div>
          <input
            id="empleado-zona-porcentaje"
            type="number"
            formControlName="zonaExtremaPorcentaje"
            [class]="controlClass('zonaExtremaPorcentaje')"
          />
          @if (hasError('zonaExtremaPorcentaje')) {
            <p class="field-message">Ingresa porcentaje.</p>
          } @else {
            <p class="field-message"></p>
          }
        </div>
      } @else {
        <div class="form-field zone-extrema-note">
          <p class="field-message field-message--muted">
            Activa “Zona extrema” para ingresar territorio y porcentaje.
          </p>
        </div>
      }
    </div>
  </app-card>
  }

  @if (isBlockVisible('semanaCorrida')) {
  <app-card className="labor-block labor-block--week">
    <div class="labor-block-head">
      <h4>Semana corrida</h4>
      <p>Marca los días pactados para evaluar semana corrida cuando corresponda.</p>
    </div>
    <div class="labor-grid labor-grid--week">
      <div class="form-field form-field--checkbox labor-toggle-field">
        <div class="field-label-row">
          <label for="empleado-semana-corrida"
            >Habilitar semana corrida</label
          >
        </div>
        <label class="employee-checkbox-row">
          <input
            id="empleado-semana-corrida"
            type="checkbox"
            formControlName="semanaCorridaActiva"
          />
          <span>Aplicar cálculo</span>
        </label>
        <p class="field-message"></p>
      </div>

      @if (formGroup.controls.semanaCorridaActiva.value) {
        <div class="form-field labor-span-3 labor-detail-field labor-detail-field--days">
          <div class="field-label-row">
            <label>Indicar días laborables</label>
            @if (isRequired('semanaCorridaDiasLaborables')) {
              <span class="field-required" aria-hidden="true">*</span>
            }
          </div>
          <div class="weekday-grid">
            @for (day of weekdayOptions; track day.value) {
              <button
                type="button"
                [class]="checkboxClass(day.value)"
                (click)="toggleWeekday(day.value)"
              >
                <span class="weekday-box"></span>
                <span>{{ day.label }}</span>
              </button>
            }
          </div>
          @if (hasError('semanaCorridaDiasLaborables')) {
            <p class="field-message">
              Selecciona al menos un día laborable cuando semana corrida esté activa.
            </p>
          } @else {
            <p class="field-message"></p>
          }
        </div>
      } @else {
        <div class="form-field week-running-note">
          <p class="field-message field-message--muted">
            Activa semana corrida para seleccionar los días.
          </p>
        </div>
      }
    </div>
  </app-card>
  }

  @if (isBlockVisible('centroCosto')) {
  <app-card className="labor-block">
    <div class="labor-block-head">
      <h4>Centro de costo y estado inicial</h4>
    </div>
    <div class="labor-grid labor-grid--footer">
      <div class="form-field">
        <div class="field-label-row">
          <label for="empleado-centro-costo"
            >Centro de costo</label
          >
        </div>
        <app-search-select
          id="empleado-centro-costo"
          formControlName="idCentroCosto"
          placeholder="Sin centro de costo"
          searchPlaceholder="Buscar centro de costo"
          [options]="centrosCostoSelectOptions"
          [invalid]="hasError('idCentroCosto')"
        ></app-search-select>
        <p class="field-message"></p>
      </div>

      <div class="form-field">
        <div class="field-label-row">
          <label for="empleado-cargo">{{ serviceOrPositionLabel() }}</label>
          @if (isRequired('cargo')) {
            <span class="field-required" aria-hidden="true">*</span>
          }
        </div>
        <input
          id="empleado-cargo"
          type="text"
          formControlName="cargo"
          [placeholder]="serviceOrPositionPlaceholder()"
          [class]="controlClass('cargo')"
        />
        @if (hasError('cargo', 'required')) {
          <p class="field-message">{{ isHonorariosMode ? 'El servicio o función es obligatorio.' : 'El cargo es obligatorio.' }}</p>
        } @else {
          <p class="field-message"></p>
        }
      </div>

      <div class="form-field">
        <div class="field-label-row">
          <label for="empleado-estado"
            >Estado de ficha inicial</label
          >
          @if (isRequired('estado')) {
            <span class="field-required" aria-hidden="true">*</span>
          }
        </div>
        <app-search-select
          id="empleado-estado"
          formControlName="estado"
          placeholder="Estado inicial"
          searchPlaceholder="Buscar estado"
          [options]="employeeStates"
          [invalid]="hasError('estado')"
        ></app-search-select>
        <p class="field-message"></p>
      </div>
    </div>
  </app-card>
  }
</section>
