{
  "name": "angular-erp",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "seed:empleados:auditoria": "node scripts/auditoria-empleados-fixtures.mjs",
    "seed:empleados:aptos": "node scripts/seed-empleados-aptos.mjs --confirm",
    "seed:empleados:aptos:append": "node scripts/seed-empleados-aptos.mjs --confirm --append",
    "seed:empleados:errores": "node scripts/seed-empleados-prueba-errores.mjs --confirm",
    "seed:empleados:errores:append": "node scripts/seed-empleados-prueba-errores.mjs --confirm --append",
    "seed:empleados:ok": "npm run seed:empleados:auditoria",
    "seed:empleados-prueba-errores": "npm run seed:empleados:errores",
    "test:supabase": "node scripts/test-supabase-api.mjs",
    "list:supabase:endpoints": "node scripts/list-supabase-endpoints.mjs",
    "test:visual": "playwright test",
    "screenshots:empleados-avanzada": "playwright test tests/empleados-creacion-avanzada.screenshots.spec.ts --workers=1",
    "test:e2e:empleados-borrador": "playwright test tests/empleados-borrador-persistencia.spec.ts --workers=1",
    "test:e2e:empleados:ui": "playwright test tests/empleados-borrador.spec.ts tests/empleados-creacion-avanzada-validaciones.spec.ts tests/empleados-wizard-stability.spec.ts tests/empleados-basic-create.spec.ts --workers=1",
    "test:e2e:empleados:db": "playwright test tests/empleados-nomina-error-fixtures.spec.ts --workers=1",
    "test:e2e:empleados": "npm run test:e2e:empleados:ui && npm run test:e2e:empleados:db",
    "test:gate:empleados": "npm run test:gate:empleados:unit && npm run test:gate:empleados:e2e",
    "test:gate:empleados:unit": "ng test --watch=false --include=**/features/empleados/**/*.spec.ts",
    "test:gate:empleados:e2e": "node scripts/gate-empleados-e2e.mjs",
    "test:e2e:parametros": "playwright test tests/parametros-workspace.spec.ts --workers=1",
    "test:e2e:parametros:flujos": "playwright test tests/parametros-workspace-flujos.spec.ts --project=parametros-db --workers=1",
    "test:gate:parametros": "node scripts/gate-parametros-e2e.mjs",
    "test:gate:parametros:unit": "ng test --watch=false --include=**/features/parametros-generales/**/*.spec.ts",
    "test:gate:parametros:e2e": "npm run test:e2e:parametros",
    "test:gate:parametros:flujos": "npm run test:e2e:parametros:flujos",
    "verify:empleados-qa": "node scripts/verify-empleados-qa-post-e2e.mjs",
    "test:e2e:nomina-flow": "playwright test tests/nomina-mensual-flow-unificado.spec.ts --workers=1",
    "test:e2e:nomina-flujo-completo": "playwright test tests/nomina-mensual-flujo-completo.spec.ts --workers=1",
    "lint:nomina-rules": "node scripts/check-nomina-rules.mjs",
    "lint:texto": "node scripts/check-text-hygiene.mjs",
    "lint:texto:update-baseline": "node scripts/check-text-hygiene.mjs --update-baseline",
    "limpiar:nominas-bd": "powershell -ExecutionPolicy Bypass -File scripts/limpiar-nominas-bd.ps1 -TodosLosPeriodos",
    "limpiar:nominas-bd:force": "powershell -ExecutionPolicy Bypass -File scripts/limpiar-nominas-bd.ps1 -TodosLosPeriodos -Force",
    "validar:esquema-nomina-bd": "powershell -ExecutionPolicy Bypass -File scripts/validar-esquema-nomina-bd.ps1",
    "types:supabase": "node scripts/generate-types.cjs",
    "zip:base": "powershell -ExecutionPolicy Bypass -File scripts/create-zip-base.ps1"
  },
  "private": true,
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@floating-ui/dom": "^1.7.6",
    "@primeuix/themes": "^2.0.3",
    "@supabase/supabase-js": "^2.103.0",
    "lucide-angular": "^1.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.6",
    "rxjs": "~7.8.0",
    "tailwindcss-primeui": "^0.6.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.7",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.2",
    "autoprefixer": "^10.5.0",
    "dotenv": "^17.4.2",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.9",
    "prettier": "^3.8.1",
    "supabase": "^2.91.2",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
